# Copy sang .env rồi chỉnh sửa: cp .env.example .env

# ── MinIO (đóng vai S3 / DBFS) ─────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=lakehouse
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── JupyterLab (đóng vai Databricks Notebook) ──────────────
JUPYTER_PORT=8888
JUPYTER_TOKEN=change-me

# ── Spark (đóng vai Databricks Runtime) ────────────────────────
SPARK_MASTER_UI_PORT=8080
SPARK_APP_UI_PORT=4040
SPARK_CONNECT_PORT=15002
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g

# ── dbt (đóng vai Workflows / DLT) ─────────────────────────
DBT_DOCS_PORT=8081

# ── Postgres (backing store cho Hive Metastore + Unity Catalog + Superset) ──
POSTGRES_USER=hive
POSTGRES_PASSWORD=change-me
POSTGRES_METASTORE_DB=metastore_db
POSTGRES_UNITY_DB=unitycatalog_db
POSTGRES_SUPERSET_DB=superset_meta

# ── Hive Metastore độc lập (Spark/dbt/Trino đọc-ghi DỮ LIỆU thật qua đây) ───
HIVE_METASTORE_PORT=9083

# ── Unity Catalog OSS (tầng GOVERNANCE — catalog ba tầng + phân quyền thật,
# Phase 6; không phục vụ đọc/ghi dữ liệu — xem docs/roadmap.md Phần 9) ───
UNITY_CATALOG_PORT=8089
# Tự ký bằng: python3 scripts/mint_uc_token.py admin
UC_ADMIN_TOKEN=change-me
# Tự ký bằng: python3 scripts/mint_uc_token.py analyst@lakehouse.local
UC_ANALYST_TOKEN=change-me

# ── Trino (đóng vai SQL Warehouse) ─────────────────────────
TRINO_PORT=8082

# ── Superset (đóng vai Databricks SQL Dashboards) ──────────
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_ADMIN_EMAIL=admin@example.com
